    "DB_DRIVERS": "-",
    "DB_TYPE": "-",
    "MIGRATION_TOOL": "-",
    "HAS_DOCKERFILE": "no",
    "HAS_K8S": "no",
    "HAS_TERRAFORM": "no",
    "CI_PIPELINE": "-",
    "LOG_LOCATIONS": "-",
    "MONITORING_TOOLS": "-",
    "ALERT_CONFIGS": "-",
    "USER_REDLINES_CODE": "",
