    "CAPABILITIES_SUMMARY": "(none)",
    "LANGUAGE": "Go",
    "FRAMEWORK": "-",
    "BUILD_SYSTEM": "go",
    "ENTRY_POINTS": "main.go",
    "ARCH_PATTERN": "modular",
