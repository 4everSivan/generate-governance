{
  "kind": "skill-routing-cases",
  "cases": {
    "small-clear-change": {
      "input": {
        "size": "small",
        "work_type": "change",
        "ambiguous": false
      },
      "expected": {
        "selected_workflow": "direct",
        "action": "execute-directly",
        "requires_confirmation": false
      }
    },
    "small-ambiguous-unconfirmed": {
      "input": {
        "size": "small",
        "work_type": "change",
        "ambiguous": true,
        "grill_me_confirmed": false
      },
      "expected": {
        "selected_workflow": "grill-me",
        "action": "request-grill-me-confirmation",
        "requires_confirmation": true
      }
    },
    "small-ambiguous-confirmed": {
      "input": {
        "size": "small",
        "work_type": "change",
        "ambiguous": true,
        "grill_me_confirmed": true
      },
      "expected": {
        "selected_workflow": "grill-me",
        "action": "start-grill-me",
        "requires_confirmation": false
      }
    },
    "small-trivial-bug": {
      "input": {
        "size": "small",
        "work_type": "bug",
