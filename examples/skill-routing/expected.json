      "input": {
        "size": "small",
        "work_type": "bug",
        "diagnosis_required": true,
        "capabilities": {
          "superpowers": {
            "confirmed": true,
            "complete": true
          }
        }
      },
      "expected": {
        "selected_workflow": "superpowers",
        "action": "start-superpowers",
        "requires_confirmation": false
      }
    },
